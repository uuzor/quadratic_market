# ─── Solana Configuration ──────────────────────────────────────────────────────

# Solana RPC endpoint
RPC_URL=http://127.0.0.1:8899

# Program ID - deployed on Solana
PROGRAM_ID=3MsEuMziRKjA1w1WTPeW5NvDUCjGoep2QZ5zBthGq23Z

# Base Mint address (USDC mint)
BASE_MINT=5WqMkrrE91UesHMJJ1ChddhTf6kNDSnoN61TKQRT3qY7

# ─── Operator/Oracle Key Configuration ─────────────────────────────────────────────────
# Path to keypair files
OPERATOR_KEYPAIR_PATH=~/.config/solana/id.json
ORACLE_KEYPAIR_PATH=~/.config/solana/id.json

# ─── Sports API Configuration ───────────────────────────────────────────────────

# The-Odds-API key (free tier: 500 requests/month)
# Get your key at: https://the-odds-api.com
ODDS_API_KEY=

# TXOdds API token (optional - for more accurate de-marginated odds)
# Sign up at https://txline.txodds.com
TXODDS_API_TOKEN=

# Football leagues to track (comma-separated)
# Supported leagues:
#   soccer_epl - English Premier League
#   soccer_uefa_champs_league - UEFA Champions League
#   soccer_uefa_europa_league - UEFA Europa League
#   soccer_spain_la_liga - Spanish La Liga
#   soccer_germany_bundesliga - German Bundesliga
#   soccer_italy_serie_a - Italian Serie A
#   soccer_france_ligue_one - French Ligue 1
SPORTS=soccer_epl,soccer_uefa_champs_league

# ─── Bot Timing Configuration ───────────────────────────────────────────────────

# How far ahead to create markets (seconds). Default: 24h
MARKET_LOOKAHEAD_SECONDS=86400

# How long after match start to wait before settling (seconds). Default: 2h
# For production: 5400 (90 min match + 30 min extra + 30 min buffer)
RESULT_DELAY_SECONDS=7200

# Poll interval for the scheduler (seconds). Default: 5 min
POLL_INTERVAL_SECONDS=300

# Market creation lead time (seconds). Default: 48h
MARKET_CREATION_LEAD_TIME=172800

# Settlement check interval (seconds). Default: 1 min
SETTLEMENT_CHECK_INTERVAL=60

# ─── Market Tracking Configuration ───────────────────────────────────────────────────

# Track and sync markets from on-chain state
SYNC_ONCHAIN_MARKETS=true

# Maximum markets to track per run
MAX_MARKETS_PER_RUN=20

# Market stage timeouts (seconds)
SUSPEND_GRACE_PERIOD=60
PROPOSAL_TIMEOUT=14400
FINALIZATION_GRACE_PERIOD=60
VOID_DEADLINE=28800

# ─── LMSR Configuration ───────────────────────────────────────────────────

# Default B parameter for LMSR (in lamports)
# 100_000_000 lamports = 0.1 SOL/USDC
LMSR_B_DEFAULT=100000000

# ─── Logging ──────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── State File ──────────────────────────────────────────────────────────────────

# Path to state file (default: bot_state.json in bot directory)
# STATE_FILE=/path/to/bot_state.json
