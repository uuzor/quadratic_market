    {
      "name": "Epoch",
      "docs": [
        "Tracks the state of an epoch — a time-bounded period during which",
        "markets are created and settled. LPs can only withdraw after their",
        "epoch's markets have all settled."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "epoch_id",
            "type": "u64"
          },
          {
            "name": "start_time",
